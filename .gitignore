# Data
data/*.csv

# MLflow / Optuna local stores
mlruns/
mlflow.db
optuna.db

# Model artifacts regenerated by training (bundle is committed deliberately;
# ignore anything regenerated locally so a retrain doesn't dirty the repo)
artifacts/*.pkl.tmp

# Secrets / cloud credentials
*.ppk
*.pem
*.env
.env
.aws/

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/
.pytest_cache/

# Notebook scratch output (regenerable by re-running the notebook; not used
# by the serving pipeline, which loads artifacts/best_model.pkl instead)
notebooks/xgb_credit_score_model.json

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Local tooling
.claude/
.playwright-cli/
